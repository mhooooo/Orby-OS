# ===========================
# REQUIRED ENVIRONMENT VARIABLES
# ===========================

# Anthropic API - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Supabase - Get from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend - Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx

# ===========================
# OPTIONAL ENVIRONMENT VARIABLES
# ===========================

# Cloudinary - For image optimization (Phase 6)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Analytics - Choose one provider (Phase 6)
# Provider selection (optional - defaults to 'plausible')
# Options: plausible | posthog | none
NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible

# Plausible (recommended - privacy-focused, GDPR-compliant)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=golfokay.co

# PostHog (alternative - more features, user tracking)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Development mode - Controls API behavior (default: live)
# Options: mock | cached | live
# DEV_MODE=live

# ===========================
# ADMIN PORTAL (Phase 7)
# ===========================

# Admin whitelist - Comma-separated list of admin emails
# Only these emails can access /admin portal
ADMIN_EMAILS=admin@example.com,another-admin@example.com
